// DaisyDays 🌼 - Girly Calendar Planner App with custom themes, user profiles, and dark mode

import { useState, useEffect } from "react";
import FullCalendar from "@fullcalendar/react";
import dayGridPlugin from "@fullcalendar/daygrid";
import timeGridPlugin from "@fullcalendar/timegrid";
import interactionPlugin from "@fullcalendar/interaction";
import axios from "axios";
import { auth, provider, signInWithPopup } from "./firebase";

const bgOptions = [
  { name: "Blush Pink", color: "#ffe4e6" },
  { name: "Lavender", color: "#f3e8ff" },
  { name: "Sky Blue", color: "#e0f2fe" },
  { name: "Mint Green", color: "#dcfce7" },
  { name: "Peach", color: "#ffe5b4" },
];

function App() {
  const [user, setUser] = useState(null);
  const [events, setEvents] = useState([]);
  const [view, setView] = useState("dayGridMonth");
  const [bgColor, setBgColor] = useState(bgOptions[0].color);
  const [darkMode, setDarkMode] = useState(false);

  useEffect(() => {
    if (user) {
      axios.get(`http://localhost:5000/api/events/${user.uid}`).then((res) => setEvents(res.data));
    }
  }, [user]);

  const handleDateClick = async (info) => {
    const title = prompt("Enter task title:");
    const assignedTo = prompt("Assign to (email or name):");
    if (title && assignedTo) {
      const newEvent = {
        title: `${title} (For: ${assignedTo})`,
        start: info.dateStr,
        end: info.dateStr,
        userId: user.uid,
        assignedTo,
      };
      const res = await axios.post("http://localhost:5000/api/events", newEvent);
      setEvents([...events, res.data]);
    }
  };

  const login = () => {
    signInWithPopup(auth, provider).then((result) => setUser(result.user));
  };

  return (
    <div
      className={`min-h-screen p-4 font-sans transition-colors duration-300 ${
        darkMode ? "bg-gray-800 text-white" : "text-black"
      }`}
      style={{ backgroundColor: darkMode ? "" : bgColor }}
    >
      {!user ? (
        <div className="text-center">
          <h1 className="text-4xl font-bold text-pink-600 mb-4">Welcome to DaisyDays 🌼</h1>
          <button onClick={login} className="bg-pink-500 text-white px-4 py-2 rounded shadow-md">
            Login with Google
          </button>
        </div>
      ) : (
        <>
          <div className="flex justify-between items-center mb-4">
            <div>
              <h1 className="text-3xl font-bold text-pink-600">DaisyDays 🌼</h1>
              <p className="text-sm text-gray-500 dark:text-gray-300">Hello, {user.displayName}</p>
            </div>
            <div className="flex space-x-2 items-center">
              <img
                src={user.photoURL || "https://via.placeholder.com/40"}
                alt="Avatar"
                className="w-10 h-10 rounded-full border-2 border-pink-300"
              />
              <select
                className="p-1 rounded border"
                onChange={(e) => setBgColor(e.target.value)}
                value={bgColor}
                disabled={darkMode}
              >
                {bgOptions.map((opt) => (
                  <option key={opt.name} value={opt.color}>{opt.name}</option>
                ))}
              </select>
              <button
                onClick={() => setDarkMode(!darkMode)}
                className="ml-2 px-2 py-1 rounded border text-sm bg-gray-200 dark:bg-gray-700 dark:text-white"
              >
                {darkMode ? "🌞 Light" : "🌙 Dark"}
              </button>
            </div>
          </div>

          <div className="flex space-x-2 mb-4">
            <button
              onClick={() => setView("timeGridDay")}
              className="bg-pink-400 hover:bg-pink-500 text-white px-3 py-1 rounded"
            >
              Daily
            </button>
            <button
              onClick={() => setView("timeGridWeek")}
              className="bg-pink-400 hover:bg-pink-500 text-white px-3 py-1 rounded"
            >
              Weekly
            </button>
            <button
              onClick={() => setView("dayGridMonth")}
              className="bg-pink-400 hover:bg-pink-500 text-white px-3 py-1 rounded"
            >
              Monthly
            </button>
          </div>

          <div className="bg-white dark:bg-gray-900 p-4 rounded-lg shadow-md">
            <FullCalendar
              plugins={[dayGridPlugin, timeGridPlugin, interactionPlugin]}
              initialView={view}
              events={events}
              dateClick={handleDateClick}
              headerToolbar={{ left: "prev,next today", center: "title", right: "" }}
              locale="en-gb"
              height="auto"
            />
          </div>
        </>
      )}
    </div>
  );
}

export default App;
